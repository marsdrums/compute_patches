// comp_init_leaves.comp
#version 460
layout(local_size_x = 256) in;

struct Key { uint morton; uint primID; };

struct Tri {
    vec4 v0;
    vec4 v1;
    vec4 v2;
};

struct Node {
    vec3 mm;        // AABB min
    uint leftChild; // leaf: LEAF_BIT | startIndexInSortedKeys
    vec3 MM;        // AABB max
    uint rightChild;// leaf: count (1..8), internal: right child index
};

layout(std430, binding = 0) readonly buffer buff_mesh    { vec4 v[]; };
layout(std430, binding = 1) readonly buffer buff_normPos { Key  key[]; };   // sorted primitive keys
layout(std430, binding = 2) buffer  buff_nodes           { Node nodes[]; };

layout(binding = 3) uniform cfg {
    uint NLeaves;
    uint NPrims;
    uint leafSize; // 2..8
};

const uint LEAF_BIT = 0x80000000u;
const uint MAX_LEAF = 8u;

Tri readTri(uint primID){
    uint id = primID * 3u;
    Tri t;
    t.v0 = v[id];
    t.v1 = v[id + 1u];
    t.v2 = v[id + 2u];
    return t;
}

void main() {
    uint leaf = gl_GlobalInvocationID.x;
    if (leaf >= NLeaves) return;

    uint start = leaf * leafSize;
    uint count = min(leafSize, NPrims - start);

    // Init to opposite infinities
    vec3 bmin = vec3( 1e30);
    vec3 bmax = vec3(-1e30);

    // Small bounded loop (<= 8)
    for (uint k = 0u; k < MAX_LEAF; ++k) {
        if (k >= count) break;

        uint prim = key[start + k].primID;
        Tri t = readTri(prim);

        vec3 a = t.v0.xyz;
        vec3 b = t.v1.xyz;
        vec3 c = t.v2.xyz;

        vec3 tmin = min(a, min(b, c));
        vec3 tmax = max(a, max(b, c));

        bmin = min(bmin, tmin);
        bmax = max(bmax, tmax);
    }

    nodes[leaf].mm         = bmin;
    nodes[leaf].MM         = bmax;
    nodes[leaf].leftChild  = (LEAF_BIT | start);
    nodes[leaf].rightChild = count;
}