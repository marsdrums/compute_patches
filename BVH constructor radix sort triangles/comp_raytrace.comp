// comp_raytrace.comp
// Ray trace triangles through the BVH
#version 460
#extension GL_GOOGLE_include_directive : require
#include "c74.noise.funcs.glsl"

struct Key { uint morton; uint primID; };

struct Node {
    vec3 mm;        // AABB min
    uint leftChild; // internal: left child node index; leaf: LEAF_BIT|startIndex
    vec3 MM;        // AABB max
    uint rightChild;// internal: right child node index; leaf: count
};

layout(std430, binding = 0) readonly buffer buff_mesh  { vec4 v[]; };
layout(std430, binding = 1) readonly buffer buff_keys  { Key  key[]; };   // sorted primitive keys
layout(std430, binding = 2) readonly buffer buff_nodes { Node nodes[]; };
layout(rgba32f, binding = 3) uniform writeonly image2D img_res;

layout(binding = 4) uniform camParams {
    vec3 pos;
    vec3 dir;
} cam;

layout(binding = 5) uniform cfg {
    uint N;         // NLeaves (root is at index N, unless N==1 -> root==0)
    vec2 fsize;
    ivec2 size;
    vec2 invSize;
    float invRatio;
    uint render_ao;
};

shared mat3 cameraBasis;

struct ray {
    vec3 origin;
    vec3 direction;
    vec3 invDir;
};

layout(local_size_x = 16, local_size_y = 16) in;

const uint LEAF_BIT = 0x80000000u;

bool intersectAABB_Ray(in ray r, vec3 bmin, vec3 bmax, float tMax, out float tNear) {
    vec3 t0 = (bmin - r.origin) * r.invDir;
    vec3 t1 = (bmax - r.origin) * r.invDir;

    vec3 tsm = min(t0, t1);
    vec3 tbg = max(t0, t1);

    float tn = max(max(tsm.x, tsm.y), tsm.z);
    float tf = min(min(tbg.x, tbg.y), tbg.z);

    tNear = max(tn, 0.0);
    return (tf >= max(tn, 0.0)) && (tn <= tMax);
}

// Möller–Trumbore, two-sided
bool intersectTri(in ray r, vec3 v0, vec3 v1, vec3 v2, inout float bestT) {
    const float EPS = 1e-7;
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;

    vec3 pvec = cross(r.direction, e2);
    float det = dot(e1, pvec);
    if (abs(det) < EPS) return false;

    float invDet = 1.0 / det;
    vec3 tvec = r.origin - v0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) return false;

    vec3 qvec = cross(tvec, e1);
    float v = dot(r.direction, qvec) * invDet;
    if (v < 0.0 || (u + v) > 1.0) return false;

    float t = dot(e2, qvec) * invDet;
    if (t <= 1e-5 || t >= bestT) return false;

    bestT = t;
    return true;
}

bool intersectTri(in ray r, vec3 v0, vec3 v1, vec3 v2, inout float bestT, out vec3 bary) {
    const float EPS = 1e-7;
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;

    vec3 pvec = cross(r.direction, e2);
    float det = dot(e1, pvec);
    if (abs(det) < EPS) return false;

    float invDet = 1.0 / det;
    vec3 tvec = r.origin - v0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) return false;

    vec3 qvec = cross(tvec, e1);
    float v = dot(r.direction, qvec) * invDet;
    if (v < 0.0 || (u + v) > 1.0) return false;

    float t = dot(e2, qvec) * invDet;
    if (t <= 1e-5 || t >= bestT) return false;

    bary = vec3(1.0 - u - v, u, v); // (w,u,v) for (v0,v1,v2)
    bestT = t;
    return true;
}


float shadowRay(in ray r) {
    const int STACK_CAP = 32;
    uint stackNode[STACK_CAP];
    int sp = 0;

    float tMax = 1e30;

    uint root = (N > 1u) ? uint(N) : 0u;
    uint node = root;

    float tmpNear;
    if (!intersectAABB_Ray(r, nodes[node].mm, nodes[node].MM, tMax, tmpNear))
        return 1.0;

    for (;;) {
        uint meta = nodes[node].leftChild;

        if ((meta & LEAF_BIT) != 0u) {
            uint start = meta & ~LEAF_BIT;
            uint count = nodes[node].rightChild;

            for (uint k = 0u; k < count; ++k) {
                uint primID = key[start + k].primID;
                uint firstVertID = primID * 3u;

                float tt = tMax; // any-hit: we only need to know if it hits
                if (intersectTri(r,
                                 v[firstVertID].xyz,
                                 v[firstVertID + 1u].xyz,
                                 v[firstVertID + 2u].xyz,
                                 tt))
                {
                    return 0.0;
                }
            }
        } else {
            uint c0 = meta;
            uint c1 = nodes[node].rightChild;

            float t0, t1;
            bool h0 = intersectAABB_Ray(r, nodes[c0].mm, nodes[c0].MM, tMax, t0);
            bool h1 = intersectAABB_Ray(r, nodes[c1].mm, nodes[c1].MM, tMax, t1);

            if (h0 && h1) {
                bool t0Closer = (t0 <= t1);
                uint nearNode = t0Closer ? c0 : c1;
                uint farNode  = t0Closer ? c1 : c0;

                if (sp < STACK_CAP) stackNode[sp++] = farNode;
                node = nearNode;
                continue;
            }
            if (h0) { node = c0; continue; }
            if (h1) { node = c1; continue; }
        }

        if (sp == 0) break;
        node = stackNode[--sp];
    }

    return 1.0;
}

void rayTrace(in ray r, out int bestPrim, out float bestT, out vec3 bestBary) {
    const int STACK_CAP = 32;
    uint  stackNode[STACK_CAP];
    float stackNear[STACK_CAP];
    int sp = 0;

    bestPrim = -1;
    bestBary = vec3(0.0);
    bestT = 1e30;

    uint root = (N > 1u) ? uint(N) : 0u;
    uint node = root;
    float nodeNear;

    if (!intersectAABB_Ray(r, nodes[node].mm, nodes[node].MM, bestT, nodeNear))
        return;

    for (;;) {
        if (nodeNear <= bestT) {
            uint meta = nodes[node].leftChild;

            if ((meta & LEAF_BIT) != 0u) {
                uint start = meta & ~LEAF_BIT;
                uint count = nodes[node].rightChild;

                for (uint k = 0u; k < count; ++k) {
                    uint primID = key[start + k].primID;
                    uint firstVertID = primID * 3u;

                    float tt = bestT;
                    vec3 bary;
                    if (intersectTri(r,
                                     v[firstVertID].xyz,
                                     v[firstVertID + 1u].xyz,
                                     v[firstVertID + 2u].xyz,
                                     tt,
                                     bary))
                    {
                        bestT = tt;
                        bestPrim = int(primID);
                        bestBary = bary;
                    }
                }
            } else {
                uint c0 = meta;
                uint c1 = nodes[node].rightChild;

                float t0, t1;
                bool h0 = intersectAABB_Ray(r, nodes[c0].mm, nodes[c0].MM, bestT, t0);
                bool h1 = intersectAABB_Ray(r, nodes[c1].mm, nodes[c1].MM, bestT, t1);

                if (h0 && h1) {
                    bool t0Closer = t0 <= t1;
                    uint nearNode = t0Closer ? c0 : c1;
                    uint farNode  = t0Closer ? c1 : c0;
                    float nearT   = t0Closer ? t0 : t1;
                    float farT    = t0Closer ? t1 : t0;

                    if (sp < STACK_CAP) { stackNode[sp] = farNode; stackNear[sp] = farT; sp++; }
                    node = nearNode;
                    nodeNear = nearT;
                    continue;
                }
                if (h0) { node = c0; nodeNear = t0; continue; }
                if (h1) { node = c1; nodeNear = t1; continue; }
            }
        }

        for (;;) {
            if (sp == 0) return;
            sp--;
            node = stackNode[sp];
            nodeNear = stackNear[sp];
            if (nodeNear <= bestT) break;
        }
    }
}

uint getSeed() {
    return gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * uint(size.x) + 999u;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    uint lid = gl_LocalInvocationIndex;

    if (lid == 0u) {
        vec3 fwd = normalize(cam.dir);
        vec3 worldUp = (abs(fwd.y) > 0.99) ? vec3(1,0,0) : vec3(0,1,0);
        vec3 right = normalize(cross(fwd, worldUp));
        vec3 up    = normalize(cross(right, fwd));
        cameraBasis = mat3(right, up, fwd);
    }
    barrier();

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 ndc = 2.0 * vec2(pixel) * invSize - 1.0;
    ndc.y *= invRatio;
    ndc.y *= -1;

    vec3 dirCam = normalize(vec3(ndc, 1.0));
    vec3 dirWorld = dirCam.x * cameraBasis[0] + dirCam.y * cameraBasis[1] + dirCam.z * cameraBasis[2];

    ray r;
    r.origin = cam.pos;
    r.direction = dirWorld;
    r.invDir = 1.0 / r.direction;

    int bestPrim;
    float bestT;
    vec3 bestBary;
    rayTrace(r, bestPrim, bestT, bestBary);

    if (bestPrim < 0) {
        imageStore(img_res, pixel, vec4(1.0));
        return;
    }

    vec3 alb = bestBary;
    vec3 res = vec3(0.0);

    vec3 hitPos = r.origin + r.direction * bestT;

    {
        r.origin = hitPos;
        r.direction = normalize(vec3(1,7,1));
        r.invDir = 1.0 / r.direction;
        r.origin += r.direction*0.001;
        float sha = shadowRay(r);
        vec3 ligCol = vec3(1,1,1);
        res += sha * ligCol * alb;        
    }


    res += alb*0.05;

    /*

