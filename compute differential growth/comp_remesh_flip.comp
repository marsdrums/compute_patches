#version 460
layout(local_size_x = 256) in;

const uint INVALID = 0xFFFFFFFFu;

struct Halfedge {
    uint to;
    uint from;
    uint next;
    uint prev;
    uint opposite;
    uint face;
    vec2 tex;
};

struct Edge { uvec2 halfedges; };
struct Face { uint halfedge; };

// Mark the mutating SSBOs as coherent because we’re using them with a cross-workgroup “mutex”.
layout(std430, binding = 0) coherent buffer buff_halfedges { Halfedge halfedges[]; };
layout(std430, binding = 1) coherent buffer buff_edges     { Edge edges[]; };
layout(std430, binding = 2) coherent buffer buff_faces     { Face faces[]; };

layout(std430, binding = 3) buffer buff_valence { uint valence[]; };

layout(std430, binding = 4) buffer readonly buff_vertices_size  { uint vs; };
layout(std430, binding = 5) buffer readonly buff_faces_size     { uint fs; };
layout(std430, binding = 6) buffer readonly buff_halfedges_size { uint hs; };
layout(std430, binding = 7) buffer readonly buff_edges_size     { uint es; };

// shared with split pass
layout(std430, binding = 8) coherent buffer buff_face_locks { uint faceLocks[]; };

layout(binding = 9) uniform cfg{
    uint remesh_enable; // 0/1
};

float sq(float x){ return x*x; }

// Acquire two face locks in a stable order (avoid deadlock)
bool lock2(uint f0, uint f1, out uint a, out uint b){
    a = min(f0, f1);
    b = max(f0, f1);

    if(atomicCompSwap(faceLocks[a], 0u, 1u) != 0u) return false;
    if(atomicCompSwap(faceLocks[b], 0u, 1u) != 0u){
        atomicExchange(faceLocks[a], 0u);
        return false;
    }

    // ACQUIRE: make sure subsequent reads see what the previous owner wrote before unlocking.
    memoryBarrierBuffer();
    return true;
}

// Release with a barrier so writes become visible before someone else acquires.
void unlock2(uint a, uint b){
    // RELEASE
    barrier();
    atomicExchange(faceLocks[a], 0u);
    atomicExchange(faceLocks[b], 0u);
}


void main(){

    if(remesh_enable == 0u) return;

    uint eid = gl_GlobalInvocationID.x;
    if(eid >= es) return;

    Edge e0 = edges[eid];
    uint h0 = e0.halfedges.x;
    uint h3 = e0.halfedges.y;

    Halfedge he0 = halfedges[h0];
    Halfedge he3 = halfedges[h3];

    uint f0 = he0.face;
    uint f1 = he3.face;

    // Quick ring sanity (pre-lock)
    uint h1 = he0.next;
    uint h4 = he3.next;
    uint h2 = halfedges[h1].next;
    uint h5 = halfedges[h4].next;

    uint v0 = halfedges[h0].from;
    uint v2 = halfedges[h0].to;
    uint v1 = halfedges[h4].to;
    uint v3 = halfedges[h1].to;

    float ed0 = float(valence[ev0]);
    float ed1 = float(valence[ev1]);
    float ed2 = float(valence[ev2]);
    float ed3 = float(valence[ev3]);

    float enoFlip = sq(ed0 - 6.0) + sq(ed1 - 6.0) + sq(ed2 - 6.0) + sq(ed3 - 6.0);
    float eflip   = sq(ed0 - 7.0) + sq(ed1 - 5.0) + sq(ed2 - 7.0) + sq(ed3 - 5.0);
    if(eflip >= enoFlip) return;

    // LOCK
    uint la, lb;
    if(!lock2(f0, f1, la, lb)) return;

    // ---- Flip edge
    // After flip:
    //   f0: v0 -> v1 -> v3
    //   f1: v1 -> v2 -> v3
    //
    // We reuse the same 6 halfedges: h0,h1,h2,h3,h4,h5

    // h0 becomes v1 -> v3 (in f0)
    halfedges[h0].from = v1;
    halfedges[h0].to   = v3;
    halfedges[h0].next = h2;
    halfedges[h0].prev = h4;
    halfedges[h0].face = f0;

    // h2 becomes v3 -> v0 (in f0)
    halfedges[h2].from = v3;
    halfedges[h2].to   = v0;
    halfedges[h2].next = h4;
    halfedges[h2].prev = h0;
    halfedges[h2].face = f0;

    // h4 stays v0 -> v1 (in f0)
    halfedges[h4].from = v0;
    halfedges[h4].to   = v1;
    halfedges[h4].next = h0;
    halfedges[h4].prev = h2;
    halfedges[h4].face = f0;

    // h3 becomes v3 -> v1 (in f1)
    halfedges[h3].from = v3;
    halfedges[h3].to   = v1;
    halfedges[h3].next = h5;
    halfedges[h3].prev = h1;
    halfedges[h3].face = f1;

    // h5 stays v1 -> v2 (in f1)
    halfedges[h5].from = v1;
    halfedges[h5].to   = v2;
    halfedges[h5].next = h1;
    halfedges[h5].prev = h3;
    halfedges[h5].face = f1;

    // h1 becomes v2 -> v3 (in f1)
    halfedges[h1].from = v2;
    halfedges[h1].to   = v3;
    halfedges[h1].next = h3;
    halfedges[h1].prev = h5;
    halfedges[h1].face = f1;

    faces[f0].halfedge = h0;
    faces[f1].halfedge = h3;

    // flipped diagonal remains this edge id
    edges[eid].halfedges = uvec2(h0, h3);

    unlock2(la, lb);
}