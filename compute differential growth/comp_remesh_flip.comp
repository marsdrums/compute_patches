#version 460
layout(local_size_x = 256) in;

const uint INVALID = 0xFFFFFFFFu;

struct Halfedge {
    uint to;
    uint from;
    uint next;
    uint prev;
    uint opposite;
    uint face;
    vec2 tex;
};

struct Edge { uvec2 halfedges; };
struct Face { uint halfedge; };

layout(std430, binding = 0) buffer buff_halfedges { Halfedge halfedges[]; };
layout(std430, binding = 1) buffer buff_edges     { Edge edges[]; };
layout(std430, binding = 2) buffer buff_faces     { Face faces[]; };

layout(std430, binding = 3) buffer readonly buff_valence { uint valence[]; };

layout(std430, binding = 4) buffer readonly buff_vertices_size  { uint vs; };
layout(std430, binding = 5) buffer readonly buff_faces_size     { uint fs; };
layout(std430, binding = 6) buffer readonly buff_halfedges_size { uint hs; };
layout(std430, binding = 7) buffer readonly buff_edges_size     { uint es; };

// shared with split pass
layout(std430, binding = 8) buffer buff_face_locks { uint faceLocks[]; };

layout(binding = 9) uniform cfg{
    uint remesh_enable; // 0/1
};

bool try_lock2(uint f0, uint f1, out uint a, out uint b){
    a = min(f0, f1);
    b = max(f0, f1);
    if(atomicCompSwap(faceLocks[a], 0u, 1u) != 0u) return false;
    if(atomicCompSwap(faceLocks[b], 0u, 1u) != 0u){
        atomicExchange(faceLocks[a], 0u);
        return false;
    }
    return true;
}

void unlock2(uint a, uint b){
    atomicExchange(faceLocks[a], 0u);
    atomicExchange(faceLocks[b], 0u);
}

float sq(float x){ return x*x; }

void main(){
    if(remesh_enable == 0u) return;

    uint eid = gl_GlobalInvocationID.x;
    if(eid >= es) return;

    Edge e0 = edges[eid];
    uint h0 = e0.halfedges.x;
    uint h3 = e0.halfedges.y;
    if(h0 == INVALID || h3 == INVALID) return;
    if(h0 >= hs || h3 >= hs) return;

    Halfedge he0 = halfedges[h0];
    Halfedge he3 = halfedges[h3];

    // manifold + opposite sanity
    if(he0.opposite != h3 || he3.opposite != h0) return;

    uint f0 = he0.face;
    uint f1 = he3.face;
    if(f0 == INVALID || f1 == INVALID) return;
    if(f0 >= fs || f1 >= fs) return;
    if(f0 == f1) return;

    // local ring (triangles)
    uint h1 = he0.next;
    uint h4 = he3.next;
    if(h1 == INVALID || h4 == INVALID) return;
    if(h1 >= hs || h4 >= hs) return;

    uint h2 = halfedges[h1].next;
    uint h5 = halfedges[h4].next;
    if(h2 == INVALID || h5 == INVALID) return;
    if(h2 >= hs || h5 >= hs) return;

    // triangle cycle checks (optional but helps avoid corruption)
    if(halfedges[h2].next != h0) return;
    if(halfedges[h5].next != h3) return;

    // vertices as in Cycling74 remesh() :contentReference[oaicite:6]{index=6}
    uint v0 = halfedges[h0].from;
    uint v2 = halfedges[h3].from;
    uint v1 = halfedges[h4].to;
    uint v3 = halfedges[h1].to;

    if(v0 >= vs || v1 >= vs || v2 >= vs || v3 >= vs) return;
    if(v1 == v3) return; // would create degenerate flipped edge

    // valence test (match article) :contentReference[oaicite:7]{index=7}
    float d0 = float(valence[v0]);
    float d1 = float(valence[v1]);
    float d2 = float(valence[v2]);
    float d3 = float(valence[v3]);

    float noFlip = sq(d0 - 6.0) + sq(d1 - 6.0) + sq(d2 - 6.0) + sq(d3 - 6.0);
    float flip   = sq(d0 - 7.0) + sq(d1 - 5.0) + sq(d2 - 7.0) + sq(d3 - 5.0);

    if(flip >= noFlip) return;

    // lock both adjacent faces so no other thread touches this quad this dispatch
    uint la, lb;
    if(!try_lock2(f0, f1, la, lb)) return;

    // re-read after lock to ensure still consistent
    he0 = halfedges[h0];
    he3 = halfedges[h3];
    if(he0.face != f0 || he3.face != f1 || he0.opposite != h3 || he3.opposite != h0){
        unlock2(la, lb);
        return;
    }

    // Recompute neighborhood after lock
    h1 = he0.next; h4 = he3.next;
    if(h1 == INVALID || h4 == INVALID || h1 >= hs || h4 >= hs){ unlock2(la, lb); return; }
    h2 = halfedges[h1].next; h5 = halfedges[h4].next;
    if(h2 == INVALID || h5 == INVALID || h2 >= hs || h5 >= hs){ unlock2(la, lb); return; }
    if(halfedges[h2].next != h0 || halfedges[h5].next != h3){ unlock2(la, lb); return; }

    // ---- Flip edge: update halfedges exactly like Cycling74 flipEdge() :contentReference[oaicite:8]{index=8}
    // After flip, triangles become (v0,v1,v3) on f0 and (v1,v2,v3) on f1.

    // h0
    halfedges[h0].from = v1;
    halfedges[h0].to   = v3;
    halfedges[h0].next = h2;
    halfedges[h0].prev = h4;
    halfedges[h0].face = f0;

    // h1
    halfedges[h1].from = v2;
    halfedges[h1].to   = v3;
    halfedges[h1].next = h3;
    halfedges[h1].prev = h5;
    halfedges[h1].face = f1;

    // h2
    halfedges[h2].from = v3;
    halfedges[h2].to   = v0;
    halfedges[h2].next = h4;
    halfedges[h2].prev = h0;
    halfedges[h2].face = f0;

    // h3
    halfedges[h3].from = v3;
    halfedges[h3].to   = v1;
    halfedges[h3].next = h5;
    halfedges[h3].prev = h1;
    halfedges[h3].face = f1;

    // h4
    halfedges[h4].from = v0;
    halfedges[h4].to   = v1;
    halfedges[h4].next = h0;
    halfedges[h4].prev = h2;
    halfedges[h4].face = f0;

    // h5
    halfedges[h5].from = v1;
    halfedges[h5].to   = v2;
    halfedges[h5].next = h1;
    halfedges[h5].prev = h3;
    halfedges[h5].face = f1;

    faces[f0].halfedge = h0;
    faces[f1].halfedge = h3;

    // e0 still uses (h0,h3)
    edges[eid].halfedges = uvec2(h0, h3);

    unlock2(la, lb);
}