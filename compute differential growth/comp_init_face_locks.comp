// Clear face locks buffer
#version 460
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer buff_face_locks { uint locks[]; };

layout(binding = 1) uniform cfg{
    uint face_capacity;
};

void main(){
    uint gid = gl_GlobalInvocationID.x;
    if(gid >= face_capacity) return;
    locks[gid] = 0u;
}