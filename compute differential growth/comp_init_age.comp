// Init age buffer
#version 460

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer writeonly buff_age { uint age[]; };
layout(        binding = 4) uniform cfg{
    uint MAX_VERTEX_COUNT;
};

void main() {

    uint gid = gl_GlobalInvocationID.x;
    if(gid >= MAX_VERTEX_COUNT) return;
    age[gid] = 200;
}
